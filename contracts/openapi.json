{
  "components": {
    "schemas": {
      "CreateCategoryDto": {
        "properties": {
          "key": {
            "example": "tech",
            "type": "string"
          },
          "name": {
            "example": "Technology",
            "type": "string"
          },
          "parentId": {
            "example": "parent-category-uuid",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name"
        ],
        "type": "object"
      },
      "CreateContentEntryDto": {
        "properties": {
          "contentTypeId": {
            "example": "content-type-uuid-or-key",
            "type": "string"
          },
          "data": {
            "example": {
              "body": "Hello world",
              "title": "My Article"
            },
            "type": "object"
          },
          "locale": {
            "example": "id",
            "type": "string"
          },
          "slug": {
            "example": "my-article-slug",
            "type": "string"
          }
        },
        "required": [
          "contentTypeId",
          "slug",
          "data"
        ],
        "type": "object"
      },
      "CreateContentTypeDto": {
        "properties": {
          "description": {
            "example": "Blog article content type",
            "type": "string"
          },
          "fields": {
            "example": [
              {
                "key": "title",
                "type": "text",
                "label": "Title",
                "required": true
              }
            ],
            "items": {
              "$ref": "#/components/schemas/FieldDefinitionDto"
            },
            "type": "array"
          },
          "isSingleton": {
            "example": false,
            "type": "boolean"
          },
          "key": {
            "example": "article",
            "type": "string"
          },
          "name": {
            "example": "Article",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "fields"
        ],
        "type": "object"
      },
      "CreateTagDto": {
        "properties": {
          "key": {
            "example": "nestjs",
            "type": "string"
          },
          "name": {
            "example": "NestJS",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name"
        ],
        "type": "object"
      },
      "FieldDefinitionDto": {
        "properties": {
          "key": {
            "example": "title",
            "type": "string"
          },
          "label": {
            "example": "Title",
            "type": "string"
          },
          "options": {
            "example": [
              "opt1",
              "opt2"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "required": {
            "example": true,
            "type": "boolean"
          },
          "type": {
            "enum": [
              "text",
              "rich_text",
              "number",
              "boolean",
              "date",
              "media",
              "reference",
              "select",
              "multi_select"
            ],
            "example": "text",
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "required"
        ],
        "type": "object"
      },
      "PublishScheduleDto": {
        "properties": {
          "scheduledAt": {
            "description": "Optional ISO8601 timestamp. When in the future, the entry is SCHEDULED and auto-published by the scheduler when due.",
            "example": "2026-05-01T09:00:00.000Z",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateCategoryDto": {
        "properties": {
          "key": {
            "example": "tech",
            "type": "string"
          },
          "name": {
            "example": "Technology",
            "type": "string"
          },
          "parentId": {
            "example": "parent-category-uuid",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateContentEntryDto": {
        "properties": {
          "contentTypeId": {
            "example": "content-type-uuid-or-key",
            "type": "string"
          },
          "data": {
            "example": {
              "body": "Hello world",
              "title": "My Article"
            },
            "type": "object"
          },
          "locale": {
            "example": "id",
            "type": "string"
          },
          "slug": {
            "example": "my-article-slug",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateContentTypeDto": {
        "properties": {
          "description": {
            "example": "Blog article content type",
            "type": "string"
          },
          "fields": {
            "example": [
              {
                "key": "title",
                "type": "text",
                "label": "Title",
                "required": true
              }
            ],
            "items": {
              "$ref": "#/components/schemas/FieldDefinitionDto"
            },
            "type": "array"
          },
          "isSingleton": {
            "example": false,
            "type": "boolean"
          },
          "key": {
            "example": "article",
            "type": "string"
          },
          "name": {
            "example": "Article",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateTagDto": {
        "properties": {
          "key": {
            "example": "nestjs",
            "type": "string"
          },
          "name": {
            "example": "NestJS",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
